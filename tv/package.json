{
  "name": "@amazon-devices/nostrobetv",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "jest --runInBand",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src __tests__ --ext .ts,.tsx",
    "lint:fix": "eslint src __tests__ --ext .ts,.tsx --fix",
    "build:release": "node ../scripts/build-tv.cjs Release",
    "build:debug": "node ../scripts/build-tv.cjs Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "typecheck": "tsc --noEmit",
    "gen:types": "node ../scripts/generate-types.cjs",
    "check:types": "node ../scripts/generate-types.cjs --check"
  },
  "dependencies": {
