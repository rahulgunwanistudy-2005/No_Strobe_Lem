{
  "plugins": [
    "@typescript-eslint",
    "@amazon-devices/eslint-plugin-kepler"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended",
    "plugin:@amazon-devices/eslint-plugin-kepler/kepler"
  ],
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      },
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "package.json",
        "kepler-compatibility.json"
      ],
      "parser": "jsonc-eslint-parser"
    },
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "excludedFiles": [
        "src/player/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@amazon-devices/*"
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "package-lock.json"
  ],
  "root": true
}
